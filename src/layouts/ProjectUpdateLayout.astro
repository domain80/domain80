---
import { Icon } from 'astro-icon/components';
import PostMetadata from '../components/blog/PostMetadata.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import Footer from '../components/layout/Footer.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import Badge from '../components/ui/Badge.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  projectTitle: string;
  projectSlug: string;
  headings: any[];
}

const { title, description, date, tags, projectTitle, projectSlug, headings } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 py-4 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-100/90 dark:bg-zinc-900/90 backdrop-blur-sm">
      <div class="max-w-5xl mx-auto px-14 flex items-center justify-between">
        <a
          href="/"
          class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors"
        >
          Domain80
        </a>

        <div class="flex gap-27 items-center">
          <a
            href={`/projects/${projectSlug}`}
            class="inline-flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400 hover:text-accent dark:hover:text-accent transition-colors mb-0"
          >
            <Icon name="tabler:arrow-narrow-left" class="w-4 h-4" />
            All {projectTitle} updates
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-14 py-12 flex-1">
      <div class="grid grid-cols-1 lg:grid-cols-[1.6fr_260px] gap-32">
        <article class="max-w-2xl">
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-4">
              {tags.map((tag) => <Badge variant="tech">{tag}</Badge>)}
            </div>
          )}

          <h1 class="text-4xl md:text-5xl font-bold mb-6 text-zinc-900 dark:text-zinc-100 leading-[110%]">
            {title}
          </h1>

          <PostMetadata
            author="David Mainoo"
            pubDate={date}
          />

          <div class="prose prose-lg dark:prose-invert max-w-none mt-12 mb-16">
            <slot />
          </div>
        </article>

        {headings.length > 0 && (
          <aside class="hidden mt-12 lg:block sticky top-24 h-fit space-y-8">
            <TableOfContents headings={headings} />
          </aside>
        )}
      </div>
    </div>

    <Footer />
  </div>
</BaseLayout>
