---
import { getCollection } from "astro:content";
import Badge from "../../components/ui/Badge.astro";
import { Icon } from "astro-icon/components";
import Footer from "../../components/layout/Footer.astro";
import ThemeToggle from "../../components/ui/ThemeToggle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const allUpdates = await getCollection("projectUpdates");

  return projects.map((project) => {
    const updates = allUpdates
      .filter((u) => !u.data.draft && u.data.project === project.id)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { project: project.id },
      props: { project, updates },
    };
  });
}

const { project, updates } = Astro.props;
const { title, description, year, endYear, status, tags } = project.data;
const yearRange = endYear ? `${year} - ${endYear}` : year;
---

<BaseLayout title={`${title} Updates`} description={description}>
  <div class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 py-4 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-100/90 dark:bg-zinc-900/90 backdrop-blur-sm">
      <div class="max-w-5xl mx-auto px-14 flex items-center justify-between">
        <a
          href="/"
          class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors"
        >
          Domain80
        </a>

        <div class="flex gap-27 items-center">
          <a
            href="/#projects"
            class="inline-flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400 hover:text-accent dark:hover:text-accent transition-colors"
          >
            <Icon name="tabler:arrow-narrow-left" class="w-4 h-4" />
            Back to projects
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <div class="max-w-3xl mx-auto px-14 py-12 flex-1 w-full">
      <!-- Project header -->
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100">
            {title}
          </h1>
          {status === "In Development" && (
            <Badge variant="amber" pill>{status}</Badge>
          )}
        </div>
        <p class="text-zinc-500 dark:text-zinc-400 text-sm mb-4">{yearRange}</p>
        <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed mb-4">
          {description}
        </p>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => <Badge variant="tech">{tag}</Badge>)}
        </div>
      </div>

      <!-- Updates list -->
      <div>
        <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-6">
          Updates
          <span class="text-sm font-normal text-zinc-500 dark:text-zinc-400 ml-2">
            {updates.length} {updates.length === 1 ? "post" : "posts"}
          </span>
        </h2>

        {updates.length === 0 ? (
          <p class="text-zinc-500 dark:text-zinc-400">No updates yet.</p>
        ) : (
          <div class="relative">
            <div class="absolute left-[7px] top-2 bottom-2 w-0.5 bg-zinc-200 dark:bg-zinc-700"></div>

            <div class="space-y-6">
              {updates.map((update) => {
                const slug = update.id.split("/").pop()!;
                const formattedDate = update.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                });

                return (
                  <a
                    href={`/projects/${project.id}/updates/${slug}`}
                    class="relative pl-8 block group"
                  >
                    <div class="absolute left-0 top-1.5 w-4 h-4 rounded-full bg-accent border-4 border-white dark:border-zinc-900"></div>

                    <article class="space-y-1">
                      <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-accent transition-colors">
                        {update.data.title}
                      </h3>
                      <p class="text-sm text-zinc-500 dark:text-zinc-400">
                        {formattedDate}
                      </p>
                      <p class="text-zinc-700 dark:text-zinc-300 text-sm leading-relaxed">
                        {update.data.description}
                      </p>
                      {update.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-1.5 pt-1">
                          {update.data.tags.map((tag) => <Badge variant="tech">{tag}</Badge>)}
                        </div>
                      )}
                    </article>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>

    <Footer />
  </div>
</BaseLayout>
